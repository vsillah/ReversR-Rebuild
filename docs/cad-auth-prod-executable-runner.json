        },
        {
          "case": "valid permitted pre-existing synthetic session after closure",
          "expected": "503 USER_UPLOADS_DISABLED"
        },
        {
          "case": "late grant duplicate attempt or concurrent run",
          "expected": "DENIED_BEFORE_BODY_READ"
