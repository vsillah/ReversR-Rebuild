{
  "buildCommand": "npm run web:export",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "includeFiles": "{server/**,node_modules/occt-import-js/dist/**}"
    }
  },
  "routes": [
    {
      "src": "^/api(?:/(.*))?$",
      "dest": "/api/[...path]?...path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
